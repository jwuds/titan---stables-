
# =============================================================================
# TITAN STABLES - ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================
# Copy this file to .env for local development
# Copy this file to .env.production for production builds
# Never commit .env or .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
# Get these values from your Supabase Project Settings -> API
# Dashboard URL: https://app.supabase.com/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# DOMAIN CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
# Production domain - update with your actual domain
VITE_DOMAIN=https://titanstables.org

# -----------------------------------------------------------------------------
# API CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# Only needed if you have external API integrations
# VITE_API_BASE_URL=https://api.example.com

# -----------------------------------------------------------------------------
# FEATURE FLAGS (OPTIONAL)
# -----------------------------------------------------------------------------
# Use these to enable/disable features in different environments
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_CHAT=false

# -----------------------------------------------------------------------------
# THIRD-PARTY API KEYS (ADD AS NEEDED)
# -----------------------------------------------------------------------------
# Only add if your application uses these services
# VITE_GOOGLE_MAPS_API_KEY=your-key-here
# VITE_STRIPE_PUBLIC_KEY=pk_test_xxx
# VITE_SENDGRID_API_KEY=SG.xxx (store in Supabase secrets, not here!)

# -----------------------------------------------------------------------------
# NOTES:
# -----------------------------------------------------------------------------
# 1. All Vite environment variables MUST start with VITE_ to be exposed to client
# 2. Never commit actual credentials to git - use .env.local for sensitive data
# 3. Set production values in Vercel dashboard, not in .env files
# 4. Supabase secrets (service role key) should ONLY be in Supabase Edge Functions
# 5. This file should only contain PUBLIC variables safe for client-side code
# =============================================================================
